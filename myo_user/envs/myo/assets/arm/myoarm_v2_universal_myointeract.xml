<mujoco model="MyoArm model for mid-air interaction tasks (v2; edited by Michal Miazga)">
    <include file="../../../../simhive/myo_sim/myoarm_v2/assets/myoarm_assets.xml"/>
    <compiler inertiafromgeom="auto" angle="radian" balanceinertia="true"
              boundmass="0.001" boundinertia=".0001"
              meshdir='../../../../simhive/myo_sim/myoarm_v2/meshes/'
              texturedir='../../../../simhive/myo_sim/myoarm_v2/meshes/'/>

    <option timestep="0.002" gravity="0 0 -9.81"/>

    <!-- Visual Settings -->
    <visual>
        <global offwidth="1920" offheight="1080"/>
    </visual>

    <!-- Assets -->
    <asset>
        <mesh file="../../../../simhive/myo_sim/myoarm_v2/meshes/human_lowpoly_nohand.stl" name="human_body"/>
    </asset>

    <worldbody>
        <!-- Lights -->
        <light name="main_light"
               directional="true"
               diffuse="2.0 2.0 2.0"
               specular="0.3 0.3 0.3"
               pos="0.6 0.2 2.0"
               dir="-0.3 -0.2 -1"/>
        <light name="top_light"
               pos="0 0 0.5"
               dir="0 0 -1"
               diffuse="1.5 1.5 1.5"
               specular="0.2 0.2 0.2"/>
        <light name="side_light_l"
               pos="0.3 0.3 0.3"
               dir="-1 -1 -1"
               diffuse="1.2 1.2 1.2"
               specular="0.2 0.2 0.2"/>
        <light name="side_light_r"
               pos="-0.3 0.3 0.3"
               dir="1 -1 -1"
               diffuse="1.2 1.2 1.2"
               specular="0.2 0.2 0.2"/>
        <light name="front_light"
               pos="0 0.3 0.2"
               dir="0 -1 0"
               diffuse="1.0 1.0 1.0"
               specular="0.1 0.1 0.1"/>

        <!-- Ground Plane -->
        <geom name="ground" type="plane" pos="0 0 0" size="2 2 0.1" rgba="0.2 0.2 0.2 1"/>


        <!-- MyoArm -->
        <body name="myoarm" pos="-.020 -0.2 1.0" euler="0 0 1.57">
            <geom name="body" type="mesh" mesh="human_body" pos="0.025 -0.1 -1.40" euler="0 0 3.14" contype="0" conaffinity="0"/>
            <include file="../../../../simhive/myo_sim/myoarm_v2/assets/myoarm_body.xml"/>
        </body>


    </worldbody>
</mujoco>
